<?xml version="1.0" encoding="utf-8"?>
<!--
  Kabuğun teması. Platform temasından türer (ADR-001: dış kütüphane yok → uyumluluk
  kütüphanesinin teması kullanılmaz).

  Tek kaynak düzeni: bütün ortak maddeler `TemaOyunTemel`de durur; `TemaOyun` yalnız ondan türer.
  Çentikli ekranlar için gereken ek madde res/values-v28/styles.xml'de aynı temele bağlı ayrı bir
  `TemaOyun` tanımıyla gelir — böylece ortak maddeler iki dosyaya kopyalanmaz.
-->
<resources>

    <style name="TemaOyunTemel" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <!-- Açılışta beyaz parlama olmasın: masa koyu zemin üzerinde durur (STIL). -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="TemaOyun" parent="TemaOyunTemel" />

</resources>
