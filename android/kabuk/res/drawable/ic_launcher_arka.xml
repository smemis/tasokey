<?xml version="1.0" encoding="utf-8"?>
<!--
  Uyarlanır simgenin ARKA katmanı (tasokey#55): koyu keçe masa zemini, tek renk.

  Tuval 108x108 dp (uyarlanır simge kuralı). Başlatıcının maskesi yalnız ortadaki 72x72 dp'yi
  gösterir, dairesel maskede güvenli alan merkezli 66 dp çaptır; bu yüzden arka katman tuvalin
  TAMAMINI doldurur — maske hangi şekli keserse kessin kenarda boşluk görünmez.

  Çizim komutu kısıtı: pathData yalnız MUTLAK M, L, C, Z içerir (yay `A`, göreli `m/l/c` ve
  kısayol `H/V/S/Q/T` yok). Sebep: API 24-25 için gereken beş PNG, geometriyi bu dosyadan OKUYAN
  bir üreticiyle çizilir (android/SIMGE.md); ayrıştırıcının komut kümesi küçük tutulmazsa ya
  ikinci bir geometri kaynağı doğar ya üretici sessizce yanlış çizer.

  Renk @color/simge_arka'dan gelir (res/values/colors.xml) — burada onaltılık değer yok.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="@color/simge_arka"
        android:pathData="M 0,0 L 108,0 L 108,108 L 0,108 Z" />

</vector>
